# /etc/olpub/collector.env  (chmod 640, root:olpub-collector)
# Đường dẫn TRÊN HOST tới thư mục "data" của Overleaf, tức <OVERLEAF_DATA_PATH>/data.
# Toolkit mặc định OVERLEAF_DATA_PATH=data/sharelatex (tương đối với thư mục toolkit).
# Xem: grep OVERLEAF_DATA_PATH <toolkit>/config/overleaf.rc
OLPUB_OL_DATA=/srv/overleaf-toolkit/data/sharelatex/data
OLPUB_PUBLISHER_URL=http://10.0.30.57:8081
OLPUB_INGEST_TOKEN_FILE=/etc/olpub/ingest.token
OLPUB_INTERVAL=5
OLPUB_MAX_PDF_MB=50
OLPUB_LOG_LEVEL=INFO
