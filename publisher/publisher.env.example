# /etc/olpub/publisher.env  (chmod 640, root:olpub)
OLPUB_DATA_DIR=/var/lib/olpub
# Thư mục file tĩnh Nginx VM 1007 phục vụ (olpub:www-data, chmod 2750)
OLPUB_WWW_DIR=/srv/olpub/www
OLPUB_APP_DIR=/opt/olpub
OLPUB_ADMIN_BIND=0.0.0.0:8082
OLPUB_INTERNAL_BIND=0.0.0.0:8081
OLPUB_PUBLIC_BASE_URL=https://read.tapama.cloud
OLPUB_OVERLEAF_ORIGIN=https://overleaf.tapama.cloud
OLPUB_INGEST_TOKEN_FILE=/etc/olpub/ingest.token
OLPUB_MAX_PDF_MB=50
# 1 = bắt buộc có cả danh tính Authelia (X-Pub-User) và chứng chỉ thiết bị (X-Pub-Device)
OLPUB_REQUIRE_USER=1
OLPUB_REQUIRE_DEVICE=1
# 1 = robots.txt chặn crawler thu thập dữ liệu huấn luyện (GPTBot, ClaudeBot, CCBot...)
OLPUB_BLOCK_TRAINING_CRAWLERS=1
OLPUB_LOG_LEVEL=INFO
